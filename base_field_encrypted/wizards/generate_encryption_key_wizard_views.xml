<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_generate_encryption_key_wizard_form" model="ir.ui.view">
        <field name="name">generate.encryption.key.wizard.form</field>
        <field name="model">generate.encryption.key.wizard</field>
        <field name="arch" type="xml">
            <form string="Encryption Key Generator">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong
                        >Danger!</strong> This is your only chance to see this key. If you close this window without copying it, you will have to generate a new one.
                    </div>
                    <group>
                        <field
                            name="key"
                            widget="CopyClipboardChar"
                            style="font-family: monospace; font-size: 1.2em;"
                        />
                        <field
                            colspan="2"
                            name="message"
                            nolabel="1"
                            style="font-family: monospace;"
                        />

                   </group>
                </sheet>
                <footer>
                    <button
                        string="Generate Another Key"
                        name="action_regenerate"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_encryption_key_wizard" model="ir.actions.act_window">
        <field name="name">Generate Encryption Key</field>
        <field name="res_model">generate.encryption.key.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Settings -> Technical -> Security -->
     <menuitem
        id="menu_generate_encryption_root"
        name="Encryption Key"
        parent="base.menu_custom"
        groups="base.group_system"
        sequence="110"
    />
    <menuitem
        id="menu_generate_encryption_key"
        name="Generate Encryption Key (Fernet)"
        parent="menu_generate_encryption_root"
        action="action_generate_encryption_key_wizard"
        groups="base.group_system"
        sequence="110"
    />
</odoo>
