        <field
            name="groups"
            eval="[Command.link(ref('base_group_subcontractor.group_subcontractor'))]"
        />
    </record>
    <record
        id="mail.ir_rule_discuss_channel_member_create_is_group_matching_group_user"
        model="ir.rule"
    >
        <field
            name="groups"
            eval="[Command.link(ref('base_group_subcontractor.group_subcontractor'))]"
        />
    </record>
    <record
        id="mail.ir_rule_discuss_channel_member_create_is_member_group_user"
        model="ir.rule"
    >
        <field
            name="groups"
            eval="[Command.link(ref('base_group_subcontractor.group_subcontractor'))]"
        />
    </record>
</odoo>
