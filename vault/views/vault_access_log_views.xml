<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vault_access_log_tree" model="ir.ui.view">
        <field name="name">vault.access.log.tree</field>
        <field name="model">vault.access.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="accessed_at" />
                <field name="secret_id" />
                <field name="user_id" />
                <field name="access_type" />
                <field name="ip_address" />
            </list>
        </field>
    </record>

    <record id="view_vault_access_log_search" model="ir.ui.view">
        <field name="name">vault.access.log.search</field>
        <field name="model">vault.access.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="secret_id" />
                <field name="user_id" />
                <field name="ip_address" />
                <filter
                    name="reveal"
                    string="Reveal"
                    domain="[('access_type', '=', 'reveal')]"
                />
                <filter
                    name="copy"
                    string="Copy"
                    domain="[('access_type', '=', 'copy')]"
                />
                <filter
                    name="export"
                    string="Export"
                    domain="[('access_type', '=', 'export')]"
                />
                <separator />
                <filter name="accessed_at" string="Accessed At" date="accessed_at" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_user"
                        string="User"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="group_secret"
                        string="Secret"
                        context="{'group_by': 'secret_id'}"
                    />
                    <filter
                        name="group_access_type"
                        string="Access Type"
                        context="{'group_by': 'access_type'}"
                    />
                    <filter
                        name="group_accessed_at"
                        string="Accessed At"
                        context="{'group_by': 'accessed_at:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_vault_access_log_form" model="ir.ui.view">
        <field name="name">vault.access.log.form</field>
        <field name="model">vault.access.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="secret_id" />
                        <field name="user_id" />
                        <field name="accessed_at" />
                        <field name="access_type" />
                        <field name="ip_address" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vault_access_log" model="ir.actions.act_window">
        <field name="name">Access Logs</field>
        <field name="res_model">vault.access.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vault_access_log_search" />
    </record>
</odoo>
