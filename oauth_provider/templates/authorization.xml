<odoo>
    <template id="authorization" name="OAuth Authorization">
        <t t-set="disable_footer" t-value="True" />
        <t t-call="web.login_layout">
            <div class="container">
                <form
                    class="oe_login_form"
                    role="form"
                    method="post"
                    action="/oauth2/authorize"
                >
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <div>
                        <h3 t-out="oauth_client" />
                        This application would like to access these resources :
                    </div>
                    <div class="list-group">
                        <span
                            t-foreach="oauth_scopes"
                            t-as="scope"
                            class="list-group-item"
                        >
                            <h4 t-field="scope.name" class="list-group-item-heading" />
                            <p
                                t-field="scope.description"
                                class="list-group-item-text"
                            />
                        </span>
                    </div>
                    <div class="clearfix oe_login_buttons text-center">
                        <button type="submit" class="btn btn-primary">Authorize</button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="authorization_error" name="OAuth Authorization Error">
        <t t-set="disable_footer" t-value="True" />
        <t t-call="web.login_layout">
            <div class="container">
                <div class="card mt-4">
                    <div class="card-header">
                        <h3 t-out="title" />
                    </div>
                    <div class="card-body" t-out="message" />
                </div>
            </div>
        </t>
    </template>
</odoo>
