<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="consent_page" name="OAuth: consent">
        <t t-call="web.login_layout">
            <t t-set="disable_footer" t-value="True" />
            <div class="o_auth_oauth_server_consent">
                <h5 class="mb-3">
                    <strong t-esc="client.name" /> wants to access your account
                </h5>
                <p t-if="client_host" class="small text-muted">
                    Published by <strong t-esc="client_host" />
                </p>
                <p t-if="unverified" class="small text-warning">
                    This application registered itself: its name is not verified.
                </p>
                <p class="small">
                    It will act as <strong t-esc="user.name" /> on
                    <strong t-esc="resource.name" />, with the same access rights
                    as you.
                </p>
                <p t-if="scopes" class="small">
                    Scopes: <t t-foreach="scopes" t-as="scope">
                        <code t-esc="scope" />
                    </t>
                </p>
                <p class="small">
                    You will then be sent to <strong t-esc="redirect_host" />.
                </p>
                <div t-if="loopback" class="alert alert-warning small" role="alert">
                    This address is on your own computer: continue only if you
                    have just started this application yourself.
                </div>
                <form method="post" action="/oauth/authorize/decision">
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <input type="hidden" name="consent" t-att-value="consent" />
                    <button
                        type="submit"
                        name="decision"
                        value="approve"
                        class="btn btn-primary w-100"
                    >Allow</button>
                    <button
                        type="submit"
                        name="decision"
                        value="deny"
                        class="btn btn-secondary w-100 mt-2"
                    >Deny</button>
                </form>
            </div>
        </t>
    </template>

    <template id="error_page" name="OAuth: error">
        <t t-call="web.login_layout">
            <t t-set="disable_footer" t-value="True" />
            <div class="alert alert-danger" role="alert">
                <p>The application's request cannot be accepted.</p>
                <p class="small mb-0">
                    <code t-esc="error.error" />
                    <t t-if="error.description">: <t t-esc="error.description" /></t>
                </p>
            </div>
        </t>
    </template>
</odoo>
