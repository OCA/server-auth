<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="oauth_server_authorization_rule_own" model="ir.rule">
        <field name="name">OAuth authorizations: own ones</field>
        <field name="model_id" ref="model_oauth_server_authorization" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="oauth_server_authorization_rule_system" model="ir.rule">
        <field name="name">OAuth authorizations: all</field>
        <field name="model_id" ref="model_oauth_server_authorization" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
